{
  "name": "ng-diagram-electric-circuit",
  "version": "1.0.0",
  "description": "Interactive circuit / schematic editor template built with Angular and ng-diagram",
  "license": "MIT",
  "keywords": [
    "visualization",
    "open-source",
    "angular",
    "typescript",
    "graph",
    "drag-and-drop",
    "diagram",
    "circuit-editor",
    "schematic",
    "diagramming",
    "node-editor",
    "node-based-ui",
    "ng-diagram"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/synergycodes/ng-diagram-electric-circuit.git"
  },
  "homepage": "https://github.com/synergycodes/ng-diagram-electric-circuit#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,scss,json,md}\""
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/router": "^19.2.25",
    "html-to-image": "^1.11.13",
    "ng-diagram": "^1.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@eslint/js": "^9.39.0",
    "angular-eslint": "19.8.1",
    "eslint": "^9.39.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.4"
  }
}
