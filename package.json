{
  "name": "ng-diagram-electric-circut",
  "version": "1.0.0",
  "description": "Interactive circuit / schematic editor template built with Angular and ng-diagram",
  "license": "MIT",
  "keywords": [
    "visualization",
    "open-source",
    "angular",
    "typescript",
    "graph",
    "drag-and-drop",
    "diagram",
    "circuit-editor",
    "schematic",
    "diagramming",
    "node-editor",
    "node-based-ui",
    "ng-diagram"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/synergycodes/ng-diagram-electric-circut.git"
  },
  "homepage": "https://github.com/synergycodes/ng-diagram-electric-circut#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,css,scss,json,md}\""
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.9",
    "html-to-image": "^1.11.13",
    "ng-diagram": "^1.2.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.9",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.4"
  }
}
